# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serper API Key (Google Search API) - https://serper.dev/api-key
SERPER_API_KEY=

# AI provider — server-side only. Do not prefix API keys with NEXT_PUBLIC_.
# One of AI_PROVIDER_API_KEY or OPENROUTER_API_KEY is required.
AI_PROVIDER_API_KEY=
# OPENROUTER_API_KEY=

# Optional. Defaults to OpenRouter if only OPENROUTER_API_KEY is set.
AI_PROVIDER_BASE_URL=

# Optional. NEXT_PUBLIC_AI_REFINER_MODEL / NEXT_PUBLIC_AI_REASONING_MODEL still work as aliases.
AI_REFINER_MODEL=
AI_REASONING_MODEL=

# Replicate API Token for AI Image Generation
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Deepgram API Key for Speech-to-Text Transcription
DEEPGRAM_API_KEY=your_deepgram_api_key_here
