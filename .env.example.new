# Serper API Key (Google Search API) - https://serper.dev/api-key
SERPER_API_KEY=

# OpenRouter API Key (AI Provider) - https://openrouter.ai/settings/keys
# This is used for all AI models (OpenAI, Google, etc.) via OpenRouter
OPENROUTER_API_KEY=

# Site Configuration for OpenRouter
NEXT_PUBLIC_SITE_URL=https://rsearch.ai
NEXT_PUBLIC_SITE_NAME=rSearch

# Landing Page Copy Text
NEXT_PUBLIC_LANDING_PAGE_COPY_TEXT="AI-powered search with advanced reasoning capabilities"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Replicate API Token for AI Image Generation
REPLICATE_API_TOKEN=your_replicate_api_token_here