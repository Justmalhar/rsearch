# Serper API Key (Google Search API) - https://serper.dev/api-key
SERPER_API_KEY=

# AI provider — server-side only. Do not prefix API keys with NEXT_PUBLIC_.
# One of AI_PROVIDER_API_KEY or OPENROUTER_API_KEY is required.
AI_PROVIDER_API_KEY=
# OpenRouter API Key (AI Provider) - https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional. Defaults to OpenRouter if only OPENROUTER_API_KEY is set.
AI_PROVIDER_BASE_URL=

# Optional. NEXT_PUBLIC_AI_REFINER_MODEL / NEXT_PUBLIC_AI_REASONING_MODEL still work as aliases.
AI_REFINER_MODEL=
AI_REASONING_MODEL=

# Site Configuration for OpenRouter
NEXT_PUBLIC_SITE_URL=https://rsearch.ai
NEXT_PUBLIC_SITE_NAME=rSearch

# Landing Page Copy Text
NEXT_PUBLIC_LANDING_PAGE_COPY_TEXT="AI-powered search with advanced reasoning capabilities"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Replicate API Token for AI Image Generation (Flux Models)
REPLICATE_API_TOKEN=your_replicate_api_token_here
